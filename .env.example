# Local development settings
NODE_ENV=development
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=libramanage

# Leave blank for local MySQL.
# For cloud MySQL, provide the path to the CA certificate file.
DB_SSL_CA=

# Replace this placeholder with a randomly generated 64-character hex secret.
SESSION_SECRET=replace_with_64_character_hex_secret

# Set this to the persistent disk directory when hosting.
BOOK_COVER_DIR=./storage/covers